# LLM settings. The easy way: ./run.sh llm (it writes llm-server/.env for you).
# By hand: copy this file to llm-server/.env and keep ONE provider block uncommented.
# Real environment variables override this file.

# --- OpenAI (default) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# --- Ollama, fully local (install ollama.com, then: ollama pull qwen2.5vl:7b) ---
# Other good choices: llama3.2-vision, gemma3:12b, minicpm-v
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5vl:7b

# --- LM Studio (load a vision model, then start the local server) ---
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=<the model id LM Studio shows>

# --- OpenRouter (":free" models work but are heavily rate-limited) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=google/gemini-2.5-flash

# --- Optional knobs (defaults shown) ---
# Reasoning models (*-reasoning, o-series, R1, gpt-5 ...) think first and need 2000+:
# LLM_MAX_TOKENS=512
# Automatic retries on rate limits / overloaded providers, and the first wait in seconds (doubles each time):
# LLM_RETRIES=2
# LLM_RETRY_BACKOFF=1.0
# Seconds per request:
# LLM_TIMEOUT=60
# Images are downscaled to this longest side before upload:
# LLM_MAX_IMAGE_SIDE=768
# OpenAI image detail: low (cheapest) or high:
# LLM_IMAGE_DETAIL=low
# Ask for token logprobs / JSON mode (both switch themselves off if the server doesn't support them):
# LLM_LOGPROBS=1
# LLM_JSON_MODE=1
